  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "log",
          "warn_sender",
          "blur_media",
          "throttle",
          "escalate"
        ]
      },
      "AnalyzeRequest": {
        "type": "object",
        "description": "Client envelope. Raw identities must be pseudonymized before storage.",
        "required": [
          "event_id",
          "kind",
          "occurred_at",
          "sender_id",
          "recipient_id",
          "platform",
          "channel"
        ],
        "properties": {
          "call": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Call"
              }
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "context": {
            "$ref": "#/components/schemas/EventContext"
          },
          "draft": {
            "type": "boolean"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "media": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Media"
              }
            ]
          },
          "message": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Message"
              }
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "platform": {
            "type": "string"
          },
          "recipient_id": {
            "type": "string"
          },
          "sender_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AnalyzeResponse": {
        "type": "object",
        "required": [
          "event_id",
          "severity",
          "tier",
          "reasons",
          "signals",
          "recommended_action",
          "secondary_actions",
          "latency_ms",
          "model_versions",
          "simulated",
          "degraded"
        ],
        "properties": {
          "alert_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "latency_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "model_versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "nudge": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Nudge"
              }
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reason"
            }
          },
          "recommended_action": {
            "$ref": "#/components/schemas/Action"
          },
          "secondary_actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecondaryAction"
            }
          },
          "severity": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 0
          },
          "signals": {
            "$ref": "#/components/schemas/Signals"
          },
          "simulated": {
            "type": "boolean"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          }
        }
      },
      "Backend": {
        "type": "string",
        "enum": [
          "onnx",
          "heuristic",
          "disabled",
          "ggml"
        ]
      },
      "Call": {
        "type": "object",
        "required": [
          "direction",
          "duration_s",
          "answered"
        ],
        "properties": {
          "answered": {
            "type": "boolean"
          },
          "direction": {
            "$ref": "#/components/schemas/CallDirection"
          },
          "duration_s": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "voicemail": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CallDirection": {
        "type": "string",
        "enum": [
          "incoming",
          "outgoing"
        ]
      },
      "CallLogImportRequest": {
        "type": "object",
        "required": [
          "csv_data"
        ],
        "properties": {
          "csv_data": {
            "type": "string"
          }
        }
      },
      "CallLogImportResponse": {
        "type": "object",
        "required": [
