  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "log",
          "warn_sender",
          "blur_media",
          "throttle",
          "escalate"
        ]
      },
      "AnalyzeRequest": {
        "type": "object",
        "description": "Client envelope. Raw identities must be pseudonymized before storage.",
        "required": [
          "event_id",
          "kind",
          "occurred_at",
          "sender_id",
          "recipient_id",
          "platform",
          "channel"
        ],
        "properties": {
          "call": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Call"
              }
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "context": {
            "$ref": "#/components/schemas/EventContext"
          },
          "draft": {
            "type": "boolean"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "media": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Media"
              }
            ]
          },
          "message": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Message"
              }
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "platform": {
            "type": "string"
          },
          "recipient_id": {
            "type": "string"
          },
          "sender_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AnalyzeResponse": {
        "type": "object",
        "required": [
          "event_id",
          "severity",
          "tier",
          "reasons",
          "signals",
          "recommended_action",
          "secondary_actions",
          "latency_ms",
          "model_versions",
          "simulated",
          "degraded"
        ],
        "properties": {
          "alert_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "latency_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "model_versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "nudge": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Nudge"
              }
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reason"
            }
          },
          "recommended_action": {
            "$ref": "#/components/schemas/Action"
          },
          "secondary_actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecondaryAction"
            }
          },
          "severity": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 0
          },
          "signals": {
            "$ref": "#/components/schemas/Signals"
          },
          "simulated": {
            "type": "boolean"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          }
        }
      },
      "Backend": {
        "type": "string",
        "enum": [
          "onnx",
          "heuristic",
          "disabled",
          "ggml"
        ]
      },
      "Call": {
        "type": "object",
        "required": [
          "direction",
          "duration_s",
          "answered"
        ],
        "properties": {
          "answered": {
            "type": "boolean"
          },
          "direction": {
            "$ref": "#/components/schemas/CallDirection"
          },
          "duration_s": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "voicemail": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CallDirection": {
        "type": "string",
        "enum": [
          "incoming",
          "outgoing"
        ]
      },
      "CallImportRequest": {
        "type": "object",
        "required": [
          "platform",
          "conversation_id",
          "csv"
        ],
        "properties": {
          "conversation_id": {
            "type": "string"
          },
          "csv": {
            "type": "string",
            "description": "UTF-8 CSV using hre-calls' nine required columns. Maximum two MiB."
          },
          "draft": {
            "type": "boolean"
          },
          "platform": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CallImportResponse": {
        "type": "object",
        "required": [
          "atomic",
          "rows"
        ],
        "properties": {
          "atomic": {
            "type": "boolean",
            "description": "Always false: each row commits independently after the whole CSV validates."
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CallImportRow"
            }
          }
        }
      },
      "CallImportRow": {
        "type": "object",
        "required": [
          "row",
          "event_id",
          "outcome"
        ],
        "properties": {
          "assessment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AnalyzeResponse"
              }
            ]
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "$ref": "#/components/schemas/RowOutcome"
          },
          "problem": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Problem"
              }
            ]
          },
          "row": {
            "type": "integer",
            "description": "One-based CSV line, counting the header as line one.",
            "minimum": 0
          }
        }
      },
      "Channel": {
        "type": "object",
        "required": [
          "type",
          "conversation_id"
        ],
        "properties": {
          "conversation_id": {
            "type": "string"
          },
          "group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "post_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "$ref": "#/components/schemas/ChannelType"
          }
        },
        "additionalProperties": false
      },
      "ChannelType": {
        "type": "string",
        "enum": [
          "dm",
          "group",
          "comment",
          "livestream",
          "voice",
          "call"
        ]
      },
      "EventContext": {
        "type": "object",
        "properties": {
          "is_contact": {
            "type": "boolean",
            "default": false
          },
          "language_hint": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "recipient_blocked_sender": {
            "type": "boolean",
            "default": false
          },
          "recipient_is_minor": {
            "type": [
              "boolean",
              "null"
            ],
            "default": null
          },
          "recipient_muted_sender": {
            "type": "boolean",
            "default": false
          },
          "reply_to_event_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          },
          "sender_account_age_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "default": null,
            "minimum": 0
          },
          "stop_requested": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "message",
          "image",
          "audio",
          "call_event"
        ]
      },
      "FeedProtection": {
        "type": "object",
        "required": [
          "subject_id",
          "enabled",
          "actions"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecondaryAction"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "subject_id": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version",
          "mock",
          "degraded"
        ],
        "properties": {
          "degraded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mock": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ImageUpload": {
        "type": "object",
        "description": "Multipart fields: `request` is an AnalyzeRequest JSON envelope; `image` is the file.",
        "required": [
          "request",
          "image"
        ],
        "properties": {
          "image": {
            "type": "string",
            "format": "binary"
          },
          "request": {
            "type": "string"
          }
        }
      },
      "Media": {
        "type": "object",
        "required": [
          "mime"
        ],
        "properties": {
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "mime": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Message": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ModelHealth": {
        "type": "object",
        "description": "Model integrity is separate from runnable inference availability.",
        "required": [
          "name",
          "hash_verified",
          "backend",
          "degraded"
        ],
        "properties": {
          "backend": {
            "$ref": "#/components/schemas/Backend"
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hash_verified": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Nudge": {
        "type": "object",
        "required": [
          "text",
          "rewrite_hint"
        ],
        "properties": {
          "rewrite_hint": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
